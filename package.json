{
  "name": "@local/dsh-default-sidebar-tab",
  "version": "0.1.0",
  "description": "Standalone DSH patch plugin: set the tab shown in the right sidebar by default. Depends only on stock DSH.",
  "type": "module",
  "main": "lib/index.mjs",
  "license": "GPL-3.0-or-later",
  "author": "Swcmb",
  "private": true,
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.2-rc.3"
  },
  "exports": {
    ".": "./lib/index.mjs",
    "./client": "./lib/client.js",
    "./config": "./lib/config.mjs",
    "./package.json": "./package.json"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "LICENSE",
    "README.md"
  ],
  "scripts": {
    "test": "node --test tests/*.test.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-ui-sidebar-right"
      ]
    }
  }
}
